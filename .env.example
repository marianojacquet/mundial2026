# ─── Base de datos ────────────────────────────────────────────────────────────
#
# OPCIÓN A — Neon (recomendado para Vercel, tier gratuito)
#   1. Crear cuenta en https://neon.tech
#   2. Crear proyecto → Connection string → elegir "Pooled connection"
#   3. Pegar acá la URL del pooler (termina en ?sslmode=require)
DATABASE_URL="postgresql://usuario:contraseña@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   4. Pegar acá la URL directa (sin "-pooler", para migraciones)
DIRECT_URL="postgresql://usuario:contraseña@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPCIÓN B — PostgreSQL local (desarrollo)
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/mundial2026"
# DIRECT_URL="postgresql://usuario:contraseña@localhost:5432/mundial2026"

# OPCIÓN C — Railway
# DATABASE_URL="postgresql://postgres:xxxx@xxxx.railway.app:xxxx/railway"
# DIRECT_URL="postgresql://postgres:xxxx@xxxx.railway.app:xxxx/railway"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-secreta-muy-larga-y-aleatoria-de-al-menos-64-chars"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción: NEXT_PUBLIC_APP_URL="https://tu-dominio.vercel.app"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# 1. Crear cuenta gratuita en https://resend.com (3000 emails/mes gratis)
# 2. Crear API Key en https://resend.com/api-keys
# 3. En producción verificar tu dominio en https://resend.com/domains
#    (sin dominio propio podés usar onboarding@resend.dev solo para pruebas)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="Mundial 2026 <noreply@tudominio.com>"
# Sin dominio verificado usar: FROM_EMAIL="Mundial 2026 <onboarding@resend.dev>"
